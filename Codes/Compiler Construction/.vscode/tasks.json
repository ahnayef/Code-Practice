{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run current .l file (Flex)",
      "type": "shell",
      "command": "runlex \"${relativeFile}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
